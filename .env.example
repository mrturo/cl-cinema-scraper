# ── General ──────────────────────────────────────────────────────────────────
HEADLESS=true
LOG_LEVEL=INFO
DB_PATH=cinema.db
REQUEST_DELAY_SECONDS=2.0
SCRAPING_INTERVAL_HOURS=6
MIN_SCRAPING_INTERVAL_HOURS=4
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# ── Chain URLs (JSON array format) ──────────────────────────────────────────
# Add one URL per theater as a JSON array.
CINEMARK_URLS=["https://www.cinemark.cl/cartelera/cinemark-mallplaza-vespucio","https://www.cinemark.cl/cartelera/cinemark-portal-nunoa"]
